{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asir.local/schema/logic_review_request.schema.json",
  "title": "Запрос локальной логической проверки ASIR",
  "type": "object",
  "required": ["contract", "contract_version", "request_id", "compilationId", "source_provenance", "fragments", "method_pack", "instructions"],
  "properties": {
    "contract": {"const": "asir.logic_review_request"},
    "contract_version": {"const": "0.2"},
    "request_id": {"type": "string", "minLength": 1},
    "compilationId": {"type": "string", "minLength": 1},
    "source_provenance": {"type": "array", "items": {"type": "object"}},
    "fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
    "method_pack": {"$ref": "#/$defs/method_pack"},
    "instructions": {"type": "object", "required": ["mode", "skill", "algorithm", "required_sections", "method_manifest", "constraints"]}
  },
  "$defs": {
    "fragment": {
      "type": "object",
      "required": ["id", "kind", "text", "source_ref"],
      "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "text": {"type": "string"}, "source_ref": {"type": "object", "required": ["relative_path"]}}
    },
    "method_pack": {
      "type": "object",
      "required": ["manifest", "algorithm", "required_sections", "system_prompt", "specifications"],
      "properties": {
        "manifest": {"type": "object", "required": ["provider", "methodology", "adaptation_version", "pack_sha256", "specifications"]},
        "algorithm": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "system_prompt": {"type": "string", "minLength": 1},
        "specifications": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "path", "sha256", "content"]}}
      }
    }
  }
}
