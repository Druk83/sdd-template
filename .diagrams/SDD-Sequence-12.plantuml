@startuml SDD-Sequence-12-Stage7
    title Последовательность событий SDD\nЭтап [7]: Системное проектирование и архитектура

    actor "Разработчик" as Dev
    participant "Агент" as Agent
    database ".source/" as Source
    database "docs/requirements/" as Docs
    collections ".manifest/" as Manifest
    collections ".requirements/" as Templates
    collections ".approach/" as Approach
    participant ".tools/" as Tools

    == ЭТАП [7]: СИСТЕМНОЕ ПРОЕКТИРОВАНИЕ И АРХИТЕКТУРА ==

    note over Agent
    Нотация: ArchiMate (всегда)
    Паттерн: согласно выбору на [2]
    (Layered/Hexagonal/Clean/...)
    Подэтапы: [7 BL], [7 AL], [7 TL], [7 SD], [7 SD.1], [7.1]
    Каждый подэтап = 4 фазы
    end note

    /'--- Подэтап [7 BL]: Business Layer ---'/

    group [7 BL] Business Layer
        Agent -> Templates: Читает H6 шаблон
        Agent -> Approach: Читает archimate.md (нотация)
        note right of Agent: ArchiMate для BL/AL/TL\nвсегда используется
        opt Архитектурный паттерн выбран на [2]
            Agent -> Approach: Читает <паттерн>.md
            note right of Agent: Layered/Hexagonal/Clean/...\nсогласно выбору [2]
        end
        Agent -> Docs: Ф1: Создает скелет
        Agent -> Docs: Ф2: Заполняет сущности BL
        note right of Agent
        Точки подтверждения:
        BL кандидаты (sdd.H4.10)
        Структура по паттерну [2]
        end note
        Agent --> Dev: Ф3: "BL кандидаты: <список>"
        alt Подтверждено
            Dev -> Agent: "Подтверждаю"
        else Корректировка
            Dev -> Agent: "Изменить: <правки>"
            Agent -> Docs: Вносит правки
        end
        Agent -> Agent: Чеклист H6 + GAP tracking
        Agent --> Dev: Ф4: "[7 BL] готов. Принять?"
        alt Принято
            Dev -> Agent: "Принято"
        else Требуется доработка
            Dev -> Agent: "Доработать: <замечания>"
            Agent -> Docs: Вносит правки
            Agent --> Dev: Ф4: "Исправлено. Принять?"
            Dev -> Agent: "Принято"
        end
    end

    /'--- Подэтап [7 AL]: Application Layer ---'/

    group [7 AL] Application Layer
        Agent -> Templates: Читает H6 шаблон
        Agent -> Approach: Читает archimate.md (нотация)
        opt Архитектурный паттерн выбран на [2]
            Agent -> Approach: Читает <паттерн>.md
        end
        Agent -> Docs: Ф1: Создает скелет
        Agent -> Docs: Ф2: Заполняет сущности AL
        note right of Agent
        Точки подтверждения:
        AL кандидаты (sdd.H4.10)
        Структура по паттерну [2]
        end note
        Agent --> Dev: Ф3: "AL кандидаты: <список>"
        alt Подтверждено
            Dev -> Agent: "Подтверждаю"
        else Корректировка
            Dev -> Agent: "Изменить: <правки>"
            Agent -> Docs: Вносит правки
        end
        Agent -> Agent: Чеклист H6 + GAP tracking
        Agent --> Dev: Ф4: "[7 AL] готов. Принять?"
        alt Принято
            Dev -> Agent: "Принято"
        else Требуется доработка
            Dev -> Agent: "Доработать: <замечания>"
            Agent -> Docs: Вносит правки
            Agent --> Dev: Ф4: "Исправлено. Принять?"
            Dev -> Agent: "Принято"
        end
    end

    /'--- Подэтап [7 TL]: Technology Layer ---'/

    group [7 TL] Technology Layer
        Agent -> Templates: Читает H6 шаблон
        Agent -> Approach: Читает archimate.md (нотация)
        opt Архитектурный паттерн выбран на [2]
            Agent -> Approach: Читает <паттерн>.md
        end
        Agent -> Docs: Ф1: Создает скелет
        Agent -> Docs: Ф2: Заполняет сущности TL
        note right of Agent
        Точки подтверждения:
        TL кандидаты (sdd.H4.10)
        Структура по паттерну [2]
        end note
        Agent --> Dev: Ф3: "TL кандидаты: <список>"
        alt Подтверждено
            Dev -> Agent: "Подтверждаю"
        else Корректировка
            Dev -> Agent: "Изменить: <правки>"
            Agent -> Docs: Вносит правки
        end
        Agent -> Agent: Чеклист H6 + GAP tracking
        Agent --> Dev: Ф4: "[7 TL] готов. Принять?"
        alt Принято
            Dev -> Agent: "Принято"
        else Требуется доработка
            Dev -> Agent: "Доработать: <замечания>"
            Agent -> Docs: Вносит правки
            Agent --> Dev: Ф4: "Исправлено. Принять?"
            Dev -> Agent: "Принято"
        end
    end


    /'--- Подэтап [7 SD]: Системное проектирование ---'/

    group [7 SD] Системное проектирование
        Agent -> Templates: Читает H6 шаблон системного проектирования
        Agent -> Manifest: Читает systemdesignmanifest.md
        Agent -> Approach: Читает выбранные подходы из registry.json
        Agent -> Docs: Ф1: Создает скелет системного проектирования
        Agent -> Docs: Ф2: Заполняет baseline, границы и компоненты
        note right of Agent
        Выходы:
        контекст и границы,
        взаимодействия и контракты,
        конфигурации и окружения,
        эксплуатация и трассируемость
        end note
        Agent --> Dev: Ф3: "Системные кандидаты: <список>"
        alt Подтверждено
            Dev -> Agent: "Подтверждаю"
        else Корректировка
            Dev -> Agent: "Изменить: <правки>"
            Agent -> Docs: Вносит правки
        end
        Agent -> Agent: Чеклист H6 + GAP tracking
        Agent --> Dev: Ф4: "[7 SD] готов. Принять?"
        alt Принято
            Dev -> Agent: "Принято"
        else Требуется доработка
            Dev -> Agent: "Доработать: <замечания>"
            Agent -> Docs: Вносит правки
            Agent --> Dev: Ф4: "Исправлено. Принять?"
            Dev -> Agent: "Принято"
        end
    end

    /'--- Подэтап [7 SD.1]: Краткие характеристики ---'/

    group [7 SD.1] Краткие характеристики
        Agent -> Templates: Читает H6 шаблон кратких характеристик
        Agent -> Docs: Читает принятый результат [7 SD]
        Agent -> Docs: Ф1: Создает производный документ
        Agent -> Docs: Ф2: Заполняет характеристики без новых фактов
        note right of Agent: Источник: только принятый системный дизайн\nНовые решения запрещены
        alt Есть неясности
            Agent --> Dev: Ф3: Вопросы по источнику [7 SD]
            Dev -> Agent: Ответы
        else Все ясно
            Agent -> Agent: Ф3: Пропуск
        end
        Agent -> Agent: Чеклист H6 + GAP tracking
        Agent --> Dev: Ф4: "[7 SD.1] готов. Принять?"
        alt Принято
            Dev -> Agent: "Принято"
        else Требуется доработка
            Dev -> Agent: "Доработать: <замечания>"
            Agent -> Docs: Вносит правки
            Agent --> Dev: "Исправлено. Принять?"
            Dev -> Agent: "Принято"
        end
    end


@enduml
